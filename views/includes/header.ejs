<!-- Header -->
<header>
    <nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
        <div class="container-fluid d-flex justify-content-evenly align-items-center">
            <div class="nav-brand">
                <a class="navbar-brand" href="/listings">
                    <i class="fa-brands fa-airbnb text-danger"></i>
                    Airbnb
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
            <div class="nav-center">
                <div class="filters d-flex justify-content-center align-items-center gap-5">
                    <div class="filter-items">
                        <a href="/listings">
                            <i class="fa-solid fa-earth-americas"></i>
                            <p>All</p>
                        </a>

                    </div>
                    <div class="filter-items">
                        <a href="/listings?category=home">
                            <i class="fa-regular fa-house"></i>
                            <p>Home</p>
                        </a>
                    </div>
                    <div class="filter-items">
                        <a href="/listings?category=mountain">
                            <i class="fa-solid fa-mountain"></i>
                            <p>Mountain</p>
                        </a>
                    </div>
                    <div class="filter-items">
                        <a href="/listings?category=service">
                            <i class="fa-solid fa-bell-concierge"></i>
                            <p>Service</p>
                        </a>
                    </div>
                </div>
                <div class="search">
                    <form class="d-flex p-0" role="search" action="/listings" method="GET">
                        <input class="form-control me-1" type="search" placeholder="Search" aria-label="search"
                            name="search" />
                        <button class="btn nav-btn-primary text-danger" type="submit"><i
                                class="fa-solid fa-magnifying-glass"></i></button>
                    </form>
                </div>
            </div>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link nav-btn-secondary p-2" href="/listings/new">Become a Host&nbsp<i
                                class="fa-solid fa-globe"></i></a>
                    </li>
                    <% if (!currUser) { %>
                        <li class="nav-item">
                            <a class="nav-link <%= (typeof currPath !== 'undefined' && currPath === '/users/login') ? 'nav-btn-primary' : 'nav-btn-secondary' %>"
                                href="/users/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= (typeof currPath !== 'undefined' && currPath === '/users/login') ? 'nav-btn-secondary' : 'nav-btn-primary' %>"
                                href="/users/signup">Sign Up</a>
                        </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link nav-btn-secondary" href="/users/logout">Logout</a>
                            </li>
                            <% } %>
                </ul>
            </div>
        </div>
    </nav>
</header>