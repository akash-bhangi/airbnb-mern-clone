<!-- Show Listing Page (for showing a single listing) -->
<% layout("layouts/boilerplate") %>
    <div class="row justify-content-center mt-1">
        <div class="col-10 col-md-8 col-lg-6">
            <h2 class="mb-2">
                <%= listing.title %>
            </h2>
            <div class="show-card card-listings">
                <img src="<%= listing.image.url%>" class="card-img-top" alt="listing image">
                <div class="card-body">
                    <p>Owned by <i>
                            <%= listing.owner.username %>
                        </i>
                    </p>
                    <p class="description">
                        <%= listing.description %>
                    </p>
                    <p class="price">
                        &#8377; <%= listing.price?.toLocaleString("en-IN") %>/night
                    </p>
                    <p class="location">
                        <%= listing.location %>
                    </p>
                    <p class="country">
                        <%= listing.country %>
                    </p>
                </div>
            </div>
            <% if( currUser && listing.owner._id.equals(currUser._id)){%>
                <div class="btn-container">
                    <a href="/listings/<%= listing._id %>/edit" style="text-decoration: none;">
                        <button class="btn btn-secondary" style="text-decoration: none;">Edit</button>
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-danger" style="text-decoration: none;">Delete</button>
                    </form>
                </div>
                <% }%>
                    <% if(currUser){%>
                        <hr>
                        <h5>Add a Review</h5>
                        <div class="col-8 mb-3">
                            <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate
                                class="needs-validation">
                                <div class="rating mb-3">
                                    <label for="rating" class="form-label">Rating</label>
                                    <fieldset class="starability-basic">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0"
                                            checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>
                                <div class="comment mb-3">
                                    <label for="comment" class="form-label">Comment</label>
                                    <textarea id="comment" name="review[comment]" rows="5" cols="60"
                                        class="form-control" required></textarea>
                                    <div class="invalid-feedback">Please enter a comment</div>
                                </div>
                                <button class="btn btn-outline-dark">Submit</button>
                            </form>
                        </div>
                        <% }%>
                            <%if (listing.reviews && listing.reviews.length> 0) {%>
                                <hr>
                                <div class="row">
                                    <h4>All Reviews</h4>
                                    <% for(let review of listing.reviews) { %>
                                        <div class="card col-5 ms-3 mb-3">
                                            <div class="card-body">
                                                <h5 class="card-title">
                                                    <%= review.author.username %>
                                                </h5>
                                                <p class="card-text">
                                                    <%= review.comment %>
                                                </p>
                                                <p class="starability-result" data-rating="<%= review.rating %>">
                                                    <%= review.rating %>
                                                </p>
                                            </div>
                                            <% if(currUser && review.author._id.equals(currUser._id)){%>
                                                <form class="mb-2" method="POST"
                                                    action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                                    <button class="btn btn-sm btn-outline-dark">Delete</button>
                                                </form>
                                                <%}%>
                                        </div>
                                        <%}%>
                                </div>
                                <%}%>
                                    <p>Where you'll be</p>
                                    <div id="map">

                                    </div>
        </div>
    </div>

    <!-- Pass the data to window/global variables first -->
    <script>
        const listing = JSON.stringify(listing);
    </script>
    <!-- Include the external map.js file -->
    <script src="/js/map.js"></script>